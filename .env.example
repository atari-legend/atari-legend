APP_NAME=AtariLegend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Folder containing the HxC Floppy Emulator 'hxcfe' binary and its two .so
# files, needed to generate the track pictures of flux dumps. Like the
# unice68/icecat binaries in resources/bin, it is not in the repository: drop it
# in resources/bin/hxcfe, which is where config/al.php looks by default, and set
# this only to point somewhere else. Must be a glibc build: the container is
# Ubuntu, and a musl-linked binary will not exec there.
# AL_HXCFE=/path/to/hxcfe/folder

# Where /music/{sndh} proxies the MP3s from. Only worth setting to point a
# test somewhere it controls.
# AL_SNDH_MP3_BASE_URL=http://sndhrecord.atari.org/mp3/

CAPTCHA_SECRET=0x0000000000000000000000000000000000000000
CAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# MATOMO_ID=1234567890

LOG_CHANNEL=stack

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=atarilegend
DB_USERNAME=atarilegend
DB_PASSWORD=atarilegend

# Mail is caught by the Mailpit container rather than sent. Read it at
# http://localhost:8025.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@atarilegend.com

# Host ports the Sail containers publish on. Uncomment and change any that
# clash with something already running.
# APP_PORT=80
# VITE_PORT=5173
# FORWARD_DB_PORT=3306
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
# FORWARD_PHPMYADMIN_PORT=8081
