# test somewhere it controls.
# AL_SNDH_MP3_BASE_URL=http://sndhrecord.atari.org/mp3/

CAPTCHA_SECRET=0x0000000000000000000000000000000000000000
CAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# MATOMO_ID=1234567890

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=atarilegend
DB_USERNAME=atarilegend
