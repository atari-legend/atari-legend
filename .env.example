APP_NAME=AtariLegend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

AL_LEGACY_BASE_URL=http://localhost:8082
# Path to folder containing the HxC Floppy Emulator 'hxcfe' binary
AL_HXCFE=/path/to/hxcfe/folder
